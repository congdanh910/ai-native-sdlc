+import { STATUSES, createTask, deleteTask, loadTasks, saveTasks, updateTask } from "./tasks.js";
+
+const createForm = document.querySelector("#create-form");
+const editForm = document.querySelector("#edit-form");
+const editDialog = document.querySelector("#edit-dialog");
+const message = document.querySelector("#message");
+let tasks = [];
+
+function showMessage(text, isError = false) {
+  message.textContent = text;
+  message.classList.toggle("error", isError);
+}
+
+function applyChange(change, successMessage) {
+  try {
+    const updated = change(tasks);
+    saveTasks(localStorage, updated);
+    tasks = updated;
+    render();
+    showMessage(successMessage);
+  } catch (error) {
+    showMessage(error instanceof Error ? error.message : "Could not save task", true);
+  }
+}
+
+function createCard(task) {
+  const card = document.createElement("article");
+  card.className = "task-card";
+  const title = document.createElement("h3");
+  title.textContent = task.title;
+  card.append(title);
+  if (task.description) {
+    const description = document.createElement("p");
+    description.textContent = task.description;
+    card.append(description);
+  }
+
+  const controls = document.createElement("div");
+  controls.className = "task-controls";
+  const label = document.createElement("label");
+  label.textContent = "Status ";
+  const select = document.createElement("select");
+  select.setAttribute("aria-label", `Status for ${task.title}`);
+  for (const status of STATUSES) {
+    const option = document.createElement("option");
+    option.value = status;
+    option.textContent = status === "todo" ? "To do" : status === "doing" ? "Doing" : "Done";
+    select.append(option);
+  }
+  select.value = task.status;
+  select.addEventListener("change", () => applyChange(
+    (current) => updateTask(current, task.id, { status: select.value }),
+    "Task moved",
+  ));
+  label.append(select);
+  controls.append(label);
+
+  const edit = document.createElement("button");
+  edit.type = "button";
+  edit.className = "secondary";
+  edit.textContent = "Edit";
+  edit.setAttribute("aria-label", `Edit ${task.title}`);
+  edit.addEventListener("click", () => {
+    editForm.elements.id.value = task.id;
+    editForm.elements.title.value = task.title;
+    editForm.elements.description.value = task.description;
+    editDialog.showModal();
+  });
+  controls.append(edit);
+
+  const remove = document.createElement("button");
+  remove.type = "button";
+  remove.className = "danger";
+  remove.textContent = "Delete";
+  remove.setAttribute("aria-label", `Delete ${task.title}`);
+  remove.addEventListener("click", () => {
+    if (window.confirm(`Delete “${task.title}”?`)) {
+      applyChange((current) => deleteTask(current, task.id), "Task deleted");
+    }
+  });
+  controls.append(remove);
+  card.append(controls);
+  return card;
+}
+
+function render() {
+  for (const status of STATUSES) {
+    const list = document.querySelector(`#${status}-list`);
+    list.replaceChildren();
+    const visible = tasks.filter((task) => task.status === status);
+    document.querySelector(`#${status}-count`).textContent = String(visible.length);
+    if (visible.length === 0) {
+      const empty = document.createElement("p");
+      empty.className = "empty";
+      empty.textContent = "No tasks yet";
+      list.append(empty);
+    } else {
+      for (const task of visible) list.append(createCard(task));
+    }
+  }
+}
+
+createForm.addEventListener("submit", (event) => {
+  event.preventDefault();
+  const input = new FormData(createForm);
+  applyChange(
+    (current) => createTask(current, {
+      title: input.get("title"), description: input.get("description"),
+    }),
+    "Task added",
+  );
+  if (!message.classList.contains("error")) createForm.reset();
+});
+
+editForm.addEventListener("submit", (event) => {
+  event.preventDefault();
+  const input = new FormData(editForm);
+  applyChange(
+    (current) => updateTask(current, input.get("id"), {
+      title: input.get("title"), description: input.get("description"),
+    }),
+    "Task updated",
+  );
+  if (!message.classList.contains("error")) editDialog.close();
+});
+
+document.querySelector("#cancel-edit").addEventListener("click", () => editDialog.close());
+
+try {
+  tasks = loadTasks(localStorage);
+} catch (error) {
+  showMessage("Saved tasks are invalid. No changes were made to local storage.", true);
+}
+render();
diff --git a/src/tasks.js b/src/tasks.js
new file mode 100644
index 0000000..bce557c
--- /dev/null
+++ b/src/tasks.js
@@ -0,0 +1,91 @@
+export const STATUSES = Object.freeze(["todo", "doing", "done"]);
+export const STORAGE_KEY = "ai-native-task-board:v1";
+
+export function validateTask(task) {
+  if (!task || typeof task !== "object" || Array.isArray(task)) {
+    throw new Error("Task must be an object");
+  }
+  if (typeof task.id !== "string" || !task.id.trim()) {
+    throw new Error("Task id is required");
+  }
+  if (typeof task.title !== "string" || !task.title.trim()) {
+    throw new Error("Task title is required");
+  }
+  if (typeof task.description !== "string") {
+    throw new Error("Task description must be text");
+  }
+  if (!STATUSES.includes(task.status)) {
+    throw new Error("Task status is invalid");
+  }
+  for (const field of ["createdAt", "updatedAt"]) {
+    if (typeof task[field] !== "string" || Number.isNaN(Date.parse(task[field]))) {
+      throw new Error(`Task ${field} is invalid`);
+    }
+  }
+  return task;
+}
+
+export function createTask(tasks, input, { id = crypto.randomUUID(), now = new Date() } = {}) {
+  const title = String(input.title ?? "").trim();
+  if (!title) throw new Error("Title is required");
+  if (tasks.some((task) => task.id === id)) throw new Error("Task id already exists");
+  const timestamp = now.toISOString();
+  const task = validateTask({
+    id,
+    title,
+    description: String(input.description ?? "").trim(),
+    status: "todo",
+    createdAt: timestamp,
+    updatedAt: timestamp,
+  });
+  return [...tasks, task];
+}
+
+export function updateTask(tasks, id, changes, { now = new Date() } = {}) {
+  if (!tasks.some((task) => task.id === id)) throw new Error("Task not found");
+  const allowed = {};
+  if (Object.hasOwn(changes, "title")) {
+    allowed.title = String(changes.title ?? "").trim();
+  }
+  if (Object.hasOwn(changes, "description")) {
+    allowed.description = String(changes.description ?? "").trim();
+  }
+  if (Object.hasOwn(changes, "status")) {
+    allowed.status = changes.status;
+  }
+  return tasks.map((task) => task.id === id
+    ? validateTask({ ...task, ...allowed, updatedAt: now.toISOString() })
+    : task);
+}
+
+export function deleteTask(tasks, id) {
+  if (!tasks.some((task) => task.id === id)) throw new Error("Task not found");
+  return tasks.filter((task) => task.id !== id);
+}
+
+export function parseTasks(raw) {
+  const parsed = JSON.parse(raw);
+  if (!Array.isArray(parsed)) throw new Error("Saved tasks must be a list");
+  const ids = new Set();
+  return parsed.map((task) => {
+    validateTask(task);
+    if (ids.has(task.id)) throw new Error("Duplicate task id");
+    ids.add(task.id);
+    return task;
+  });
+}
+
+export function loadTasks(storage) {
+  const raw = storage.getItem(STORAGE_KEY);
+  return raw === null ? [] : parseTasks(raw);
+}
+
+export function saveTasks(storage, tasks) {
+  const ids = new Set();
+  for (const task of tasks) {
+    validateTask(task);
+    if (ids.has(task.id)) throw new Error("Duplicate task id");
+    ids.add(task.id);
+  }
+  storage.setItem(STORAGE_KEY, JSON.stringify(tasks));
+}
