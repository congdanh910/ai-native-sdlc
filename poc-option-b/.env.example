# Created by `./sdlc init`, which replaces every CHANGE_ME value with a generated secret.
# Never commit .env.

# The single operator of this POC. Every human decision is recorded with this name.
SDLC_OPERATOR=CHANGE_ME_OPERATOR

# Controller database (docker compose service controller-db)
SDLC_DB_PASSWORD=CHANGE_ME_SECRET
SDLC_DB_PORT=55442

# Langflow and its database
LANGFLOW_DB_PASSWORD=CHANGE_ME_SECRET
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_SECRET
LANGFLOW_SECRET_KEY=CHANGE_ME_SECRET
LANGFLOW_API_KEY=CHANGE_ME_SECRET
LANGFLOW_PORT=7870

# Controller API and web control room (loopback only)
SDLC_API_PORT=8770

# Which implementation plays the AI roles:
#   mock  - every role is deterministic; no model is called
#   qwen3 - thinking roles (Business Analyst, Tech Lead, QA Analyst, Code Reviewer) run on Qwen3 via Langflow.
#           Uses GX10.
SDLC_TEAM_MODE=mock

# Which implementation plays the doing roles (QA Engineer, Developer, Validation Gate, Release Engineer):
#   mock - nothing is written, validated or pushed
#   cli  - Codex CLI / Claude Code CLI under your subscription logins write tests and code in the run worktree,
#          validation runs in the project's toolchain container without network, and GitHub projects get a
#          real draft PR (never merged by the platform). Uses subscription time and pushes branches.
SDLC_DOING_MODE=mock

# Optional: secret of a GitHub webhook forwarded to /api/webhooks/github (see docs/runbook.md).
# Empty: the worker polls open draft PRs every minute instead.
GITHUB_WEBHOOK_SECRET=

# Ollama on GX10, reached through an SSH tunnel:
# Mac 127.0.0.1:OLLAMA_TUNNEL_PORT -> GX10 127.0.0.1:OLLAMA_REMOTE_PORT
# Langflow reaches the tunnel at http://host.docker.internal:OLLAMA_TUNNEL_PORT.
OLLAMA_TUNNEL_PORT=11435
OLLAMA_REMOTE_PORT=11437
OLLAMA_MODEL=qwen3:30b-instruct
OLLAMA_NUM_CTX=8192
# Characters of repository content given to a thinking role (about 4 characters per token)
CONTEXT_CHAR_BUDGET=16000

GX10_SSH_HOST=CHANGE_ME_USER@CHANGE_ME_HOST
GX10_SSH_PORT=22
GX10_SSH_IDENTITY_FILE=CHANGE_ME_PATH_TO_PRIVATE_KEY

# Read-only capacity check before model use (reported by `./sdlc doctor`)
GX10_MIN_AVAILABLE_MIB=65536
GX10_MAX_GPU_UTIL=20
