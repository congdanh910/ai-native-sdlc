# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Use URL-safe characters in database passwords because Langflow receives a URL.
SDLC_DB_PASSWORD=CHANGE_ME_SDLC_DB_PASSWORD
LANGFLOW_DB_PASSWORD=CHANGE_ME_LANGFLOW_DB_PASSWORD
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_LANGFLOW_ADMIN_PASSWORD
# Generate with: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
LANGFLOW_SECRET_KEY=CHANGE_ME_LANGFLOW_SECRET_KEY
LANGFLOW_API_KEY=CHANGE_ME_RANDOM_LANGFLOW_API_KEY

SDLC_DB_PORT=55432
LANGFLOW_PORT=7860
DATABASE_URL=postgresql+psycopg://sdlc:CHANGE_ME_SDLC_DB_PASSWORD@127.0.0.1:55432/sdlc
CONTROLLER_TOKEN=CHANGE_ME_RANDOM_CONTROLLER_TOKEN
ALLOWED_REPOS=CHANGE_ME_OWNER_REPO
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GITHUB_WEBHOOK_SECRET
GITHUB_REQUIRED_CHECK=task-board-tests
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_REQUIREMENTS_FLOW_ID=
LANGFLOW_PLANNING_FLOW_ID=
LANGFLOW_REVIEW_FLOW_ID=

# SSH tunnel uses 11435 because local Ollama already binds 11434 on this Mac.
# The flow's Ollama URL is http://host.docker.internal:11435.
OLLAMA_TUNNEL_PORT=11435

# Optional defaults for `python -m scripts.sdlc analyze|review`.
GX10_SSH_HOST=cdp@CHANGE_ME_GX10_HOST
GX10_SSH_PORT=2222
GX10_SSH_IDENTITY_FILE=CHANGE_ME_LOCAL_SSH_KEY_PATH
